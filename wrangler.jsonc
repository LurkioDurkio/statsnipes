{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statsnipes",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statsnipes_d1",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
